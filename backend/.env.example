# For an existing LOCAL MongoDB instead of npm run dev:local:
MONGO_URI=mongodb://127.0.0.1:27017/tg_const_admin_local
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Generate a random secret of at least 32 characters; never commit the real value.
AUTH_SESSION_SECRET=
# false only for local HTTP. Set true when deploying behind HTTPS.
AUTH_COOKIE_SECURE=false
# Only if using a known reverse proxy; never set trust proxy=true globally.
# AUTH_TRUST_PROXY=loopback,172.18.0.0/16
